# Copy to .env.local (gitignored) and fill in. Never commit real tokens.

# Aha uses OAuth via: agent-sdk mcp oauth aha --dir .
# Mural uses OAuth via: agent-sdk mcp oauth mural --dir .

# DPJ (OpenProject) — personal API token with MCP access
OPENPROJECT_URL=https://dpj.int.bayer.com
OPENPROJECT_API_KEY=
